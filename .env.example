# =============================================================================
# Kaupet.no — Miljøvariabler
# =============================================================================
# Kopier denne filen til `.env` og fyll inn verdier for lokal kjøring.
# VITE_*-variabler er publishable (bundles inn i klienten). Alle andre er
# server-only og leses kun fra serverfunksjoner / SSR.
# =============================================================================


# -----------------------------------------------------------------------------
# Supabase — OBLIGATORISK
# -----------------------------------------------------------------------------
# Klient + server bruker samme prosjekt. Publishable key er trygg i klienten;
# service role key må ALDRI eksponeres til frontend.

SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL=""
VITE_SUPABASE_PUBLISHABLE_KEY=""

# Skiller produksjon fra staging i klientkoden (bl.a. gjør kategori-editoren
# i /admin/kategorier read-only her, med en "Synkroniser fra staging"-knapp,
# mens staging forblir fullt redigerbar).
VITE_ENVIRONMENT="production"

# -----------------------------------------------------------------------------
# Staging-synk for category data (production only) — server-only
# The synchronizer only reads public category tables. Use the staging
# publishable key, never a staging service-role key in the production Worker.
STAGING_SUPABASE_URL=""
STAGING_SUPABASE_PUBLISHABLE_KEY=""


# -----------------------------------------------------------------------------
# Vipps / MobilePay — kreves for betaling (promoteringer)
# -----------------------------------------------------------------------------
# `VIPPS_ENVIRONMENT` styrer hvilken nøkkelgruppe som brukes.
# Sett til "test" for å bruke VIPPS_TEST_*; ellers brukes produksjon.

VIPPS_ENVIRONMENT="test"

# Produksjon
VIPPS_CLIENT_ID=""
VIPPS_CLIENT_SECRET=""
VIPPS_SUBSCRIPTION_KEY=""
VIPPS_MSN=""
VIPPS_WEBHOOK_SECRET=""

# Test
VIPPS_TEST_CLIENT_ID=""
VIPPS_TEST_CLIENT_SECRET=""
VIPPS_TEST_SUBSCRIPTION_KEY=""
VIPPS_TEST_MSN=""
VIPPS_TEST_WEBHOOK_SECRET=""


# -----------------------------------------------------------------------------
# Push-varsler (Web Push / VAPID)
# -----------------------------------------------------------------------------
# Genereres med f.eks. `npx web-push generate-vapid-keys`.
# VAPID_SUBJECT er valgfri (default: mailto:kontakt@kaupet.no).

VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:kontakt@kaupet.no"


# -----------------------------------------------------------------------------
# Push-varsler (Android native / Firebase Cloud Messaging)
# -----------------------------------------------------------------------------
# Hentes fra Firebase Console -> Project Settings -> Service Accounts ->
# Generate new private key. Lim inn hele JSON-filens innhold som én linje.

FCM_SERVICE_ACCOUNT_JSON=""


# -----------------------------------------------------------------------------
# Cloudflare Turnstile — bot-beskyttelse ved annonsepublisering
# -----------------------------------------------------------------------------
# Registrer site på https://dash.cloudflare.com/ under Turnstile.
# Velg widget-type «Managed» (usynlig for vanlige brukere).
# Testmodus: siteKey=1x00000000000000000000AA, secretKey=1x0000000000000000000000000000000AA

TURNSTILE_SECRET_KEY=""
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_ALLOWED_HOSTNAMES="kaupet.no,www.kaupet.no"

# Keyed IP fingerprints for abuse-control buckets. Keep this secret separate
# from Supabase and rotate it only with a planned bucket reset.
RATE_LIMIT_HMAC_SECRET=""


# -----------------------------------------------------------------------------
# Statens vegvesen — kjøretøyoppslag ved annonsering av bil/MC/bobil/henger osv.
# -----------------------------------------------------------------------------
# API-nøkkel for Kjøretøyoppslag-API-et (Datautlevering). Server-only.

STATENS_VEGVESEN_API_KEY=""


# -----------------------------------------------------------------------------
# Supabase Auth — branded bekreftelsesmail (server-/driftskonfigurasjon)
# -----------------------------------------------------------------------------
# RESEND_API_KEY brukes både av serverens transaksjonelle e-post og lokal
# Supabase Auth SMTP. Legg aldri denne nøkkelen i en VITE_*-variabel.

RESEND_API_KEY=""
RESEND_FROM_EMAIL="Kaupet.no <ikkesvar@varsel.kaupet.no>"

# Internmottaker for Proff-bestillinger. Fase 0 lager fakturaen manuelt i
# Fiken, så en bestilling må varsles til et menneske. La stå tom for å varsle
# alle brukere med admin-rollen i stedet.
PROFF_ORDER_INBOX="salg@kaupet.no"


# -----------------------------------------------------------------------------
# Mistral — AI-kategoriforslag (server-only)
# -----------------------------------------------------------------------------
# Mistral Small 4 brukes kun fra serverfunksjoner. Legg aldri denne nøkkelen i
# en VITE_*-variabel.

MISTRAL_API_KEY=""


# -----------------------------------------------------------------------------
# Diverse
# -----------------------------------------------------------------------------
# PUBLIC_SITE_URL brukes som fallback for absolutte URL-er (f.eks. i
# webhook-callbacks). La stå tom for å bruke relative URL-er.

PUBLIC_SITE_URL=""

# NODE_ENV settes vanligvis automatisk av Vite/runtime. Overstyr kun ved behov.
# NODE_ENV="development"

MISTRAL_PHOTO_SUGGESTIONS_ENABLED="false"
