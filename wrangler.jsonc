{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Nitro fills in compatibility_date, main, assets and nodejs_compat
  // automatically at build time — this file only pins the stable bits
  // we don't want to depend on inference (like the git remote).
  // Worker name for staging is overridden at build time via the
  // CLOUDFLARE_WORKER_NAME env var (see vite.config.ts) — Wrangler's
  // redirected-config mode used by Nitro's deployConfig rejects `env.*`
  // blocks, so a plain `wrangler.jsonc` env can't be used here.
  "name": "kaupet-no",
  // Cloudflare Images-binding brukt av src/lib/image-compression.server.ts til
  // å komprimere bilder hentet serverside (Excel-/API-/MCP-synk), med samme
  // presets som klientkomprimeringen (src/lib/image-presets.ts). Bindingen
  // finnes kun i selve Worker-kjøretiden — i dev (Vite uten Nitro) og vitest
  // er `env.IMAGES` fraværende, noe `image-compression.server.ts` håndterer
  // som en INTERN feil (jobben utsettes, aldri en kundefeil), ikke en krasj.
  "images": { "binding": "IMAGES" },
}
